<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_button_height"
        android:orientation="horizontal">

        <Button
            android:id="@+id/back_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:paddingStart="@dimen/settings_button_padding"
            android:paddingEnd="@dimen/settings_button_padding"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:backgroundTint="@color/white"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/arrow_back"
            app:iconPadding="12dp"
            app:iconTint="@color/YP_Black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/settings_button"
            android:textColor="@color/YP_Black"
            android:textSize="@dimen/main_button_text"
            android:textAllCaps="false"
            android:gravity="center"
            android:padding="12dp"
            android:letterSpacing="0"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_button_height"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dark_theme"
            android:textSize="@dimen/settings_text"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:letterSpacing="0"/>

        <androidx.appcompat.widget.SwitchCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </LinearLayout>

    <Button
        android:id="@+id/share_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:paddingStart="@dimen/settings_button_padding"
        android:paddingEnd="@dimen/settings_button_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_button_height"
        android:text="@string/share_app"
        android:textSize="@dimen/settings_text"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:textAlignment="textStart"
        android:textAllCaps="false"
        app:icon="@drawable/share"
        app:iconGravity="end"
        app:iconTint="@color/YP_Text_Grey"
        android:fontFamily="sans-serif-smallcaps"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"/>

    <Button
        android:id="@+id/support_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:paddingStart="@dimen/settings_button_padding"
        android:paddingEnd="@dimen/settings_button_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_button_height"
        android:text="@string/support"
        android:textSize="@dimen/settings_text"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:textAlignment="textStart"
        android:textAllCaps="false"
        app:icon="@drawable/support"
        app:iconGravity="end"
        app:iconTint="@color/YP_Text_Grey"
        android:fontFamily="sans-serif-smallcaps"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"/>

    <Button
        android:id="@+id/user_agreement_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:paddingStart="@dimen/settings_button_padding"
        android:paddingEnd="@dimen/settings_button_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_button_height"
        android:text="@string/user_agreement"
        android:textSize="@dimen/settings_text"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:textAlignment="textStart"
        android:textAllCaps="false"
        app:icon="@drawable/arrow_forward"
        app:iconGravity="end"
        app:iconTint="@color/YP_Text_Grey"
        android:fontFamily="sans-serif-smallcaps"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"/>

</LinearLayout>