<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="61dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/music_card_padding"
    android:paddingBottom="@dimen/music_card_padding"
    android:paddingStart="13dp"
    android:paddingEnd="12dp">

    <ImageView
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:id="@+id/album_img"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/music_card_padding"
        android:paddingEnd="@dimen/music_card_padding"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/track_name"
            android:textSize="16sp"
            android:textColor="@color/settings_text"
            android:letterSpacing="0"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Here Comes The Sun"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/artist_name"
                style="@style/SearchGroupName"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/music_author_height"
                android:ellipsize="end"
                android:singleLine="true"
                tools:text="The Beatles"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dot_icon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <ImageView
                android:id="@+id/dot_icon"
                android:layout_width="@dimen/music_author_height"
                android:layout_height="@dimen/music_author_height"
                android:src="@drawable/dot"
                app:tint="@color/music_card_text"
                app:layout_constraintStart_toEndOf="@+id/artist_name"
                app:layout_constraintEnd_toStartOf="@+id/track_time"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/track_time"
                style="@style/SearchGroupName"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/music_author_height"
                tools:text="4:01"
                app:layout_constraintStart_toEndOf="@+id/dot_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/arrow_forward"
        android:layout_gravity="center"
        app:tint="@color/music_card_text"/>

</LinearLayout>